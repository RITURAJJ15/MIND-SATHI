{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/gemini/(.*)",
      "destination": "/api/gemini?action=$1"
    },
    {
      "source": "/api/sync/(.*)",
      "destination": "/api/sync?action=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/caregiver",
      "destination": "/caregiver.html"
    },
    {
      "source": "/caregiver/(.*)",
      "destination": "/caregiver.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
