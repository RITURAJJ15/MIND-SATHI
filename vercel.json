{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/caregiver",
      "destination": "/caregiver.html"
    },
    {
      "source": "/caregiver/(.*)",
      "destination": "/caregiver.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
